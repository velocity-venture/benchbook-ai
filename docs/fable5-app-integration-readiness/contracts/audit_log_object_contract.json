  "body_text_included": false,
  "spec_document": "docs/fable5-app-integration-readiness/09_AUDIT_LOGGING_AND_TRACEABILITY_SPEC.md",
  "write_points": [
    {"event": "every_retrieval_attempt", "table": "legal_authority.retrieval_logs", "timing": "before_response_streams"},
    {"event": "every_refusal_all_stages", "table": "legal_authority.refusal_records", "timing": "at_refusal_emission"},
    {"event": "every_answer", "table": "legal_authority.answer_audit_records", "timing": "after_stream_completion"},
    {"event": "every_displayed_citation", "table": "legal_authority.citation_verification_records", "timing": "with_answer_persistence"}
  ],
  "content_rules": [
    "production mode stores query hashes only, never excerpts",
    "qa mode excerpts require the owner flag, default off, purge-first retention",
    "no legal chunk passages in any log field; chunk ids and hashes only",
    "no juvenile or party names in any log field",
    "audit write failure on the answer path fails closed"
  ],
