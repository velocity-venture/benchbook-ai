  "field_rules": {
    "outcome": {
      "enum": ["results", "no_authority", "refused_pre_retrieval"]
    },
    "results.gated_chunk_passage": {
      "rule": "runtime-only field carrying the gated span for prompt assembly; never persisted to logs; always a placeholder in contract and mock files"
    },
    "gate_attestation": {
      "rule": "all four booleans must be true before any result use; any false is an internal-error refusal, never a degraded answer"
    },
    "envelopes": {
      "rule": "answer_support and reference_material are disjoint; DCS rows appear only in reference_material"
    }
  },
