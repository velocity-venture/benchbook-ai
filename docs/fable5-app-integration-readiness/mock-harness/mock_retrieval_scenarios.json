    {
      "scenario_id": "MR-10",
      "category": "result_limit_clamp",
      "description": "Request limit above cap is clamped to 50 before the adapter call",
      "request": {"result_limit_category": "above_cap", "family_filter": ["tca_title_36"], "answer_scope_intent": "general_answer"},
