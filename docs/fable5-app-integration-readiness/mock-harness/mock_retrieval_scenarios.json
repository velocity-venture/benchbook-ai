    {
      "scenario_id": "MR-09",
      "category": "as_of_conformity",
      "description": "Fixture returns a row whose version window excludes the as-of date; GQ-4 raises internal-error refusal",
      "request": {"as_of_date_category": "today", "family_filter": ["tca_title_37"], "answer_scope_intent": "general_answer"},
      "fixture": {"fts_rows": 1, "row_version_window_excludes_as_of": true},
      "scripted_generation_profile": "not_called",
      "expected": {"gq4_failure": true, "response_class": "REFUSE_NO_AUTHORITY", "defect_alert": true},
      "tiers": ["T1", "T2"]
