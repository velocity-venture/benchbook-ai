      "fixture": {"adapter_throws": true},
      "scripted_generation_profile": "not_called",
      "expected": {"response_class": "REFUSE_NO_AUTHORITY", "refusal_variant": "retrieval_error", "model_called": false, "no_partial_answer": true},
